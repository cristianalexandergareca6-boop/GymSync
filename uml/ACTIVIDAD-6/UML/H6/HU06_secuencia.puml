@startuml
left to right direction

actor Recepcionista

rectangle "Sistema de Gestión de Membresías" {

    usecase "Visualizar estado de membresía" as UC1
    usecase "Consultar membresía" as UC2
    usecase "Calcular días restantes" as UC3
    usecase "Clasificar estado" as UC4

    usecase "Mostrar verde:\nMembresía activa" as UC5
    usecase "Mostrar amarillo:\nPróxima a vencer" as UC6
    usecase "Mostrar rojo:\nMembresía vencida" as UC7
}

Recepcionista --> UC1

UC1 ..> UC2 : <<include>>
UC1 ..> UC3 : <<include>>
UC1 ..> UC4 : <<include>>

UC5 ..> UC4 : <<extend>>
UC6 ..> UC4 : <<extend>>
UC7 ..> UC4 : <<extend>>

@enduml
