@startuml
left to right direction

actor Recepcionista

rectangle "Sistema de Control de Ingresos" {

    usecase "Registrar ingreso de socio" as UC1
    usecase "Identificar socio" as UC2
    usecase "Consultar membresía" as UC3
    usecase "Validar vigencia" as UC4
    usecase "Registrar fecha y hora" as UC5
    usecase "Asociar ingreso al socio" as UC6
    usecase "Guardar ingreso" as UC7
    usecase "Mostrar confirmación" as UC8

    usecase "Denegar ingreso" as UC9
}

Recepcionista --> UC1

UC1 ..> UC2 : <<include>>
UC1 ..> UC3 : <<include>>
UC1 ..> UC4 : <<include>>
UC1 ..> UC5 : <<include>>
UC1 ..> UC6 : <<include>>
UC1 ..> UC7 : <<include>>
UC1 ..> UC8 : <<include>>

UC9 ..> UC1 : <<extend>>

@enduml
