@startuml
left to right direction

actor Recepcionista

rectangle "Sistema de Gestión de Socios" {

    usecase "Consultar y actualizar\n datos de socio" as UC1
    usecase "Buscar socio registrado" as UC2
    usecase "Mostrar datos del socio" as UC3
    usecase "Modificar información" as UC4
    usecase "Validar datos modificados" as UC5
    usecase "Guardar cambios" as UC6
    usecase "Mostrar confirmación" as UC7

    usecase "Mostrar error:\nSocio no encontrado" as UC8
    usecase "Mostrar error:\nDatos inválidos" as UC9
}

Recepcionista --> UC1

UC1 ..> UC2 : <<include>>
UC1 ..> UC3 : <<include>>
UC1 ..> UC4 : <<include>>
UC1 ..> UC5 : <<include>>
UC1 ..> UC6 : <<include>>
UC1 ..> UC7 : <<include>>

UC8 ..> UC1 : <<extend>>
UC9 ..> UC1 : <<extend>>

@enduml
